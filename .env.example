OVERLORD_DATABASE_PATH=var/overlord.sqlite3
OVERLORD_HOST=127.0.0.1
OVERLORD_PORT=8000
OVERLORD_LOG_LEVEL=INFO
OVERLORD_PROVIDER=mock

# Minimum seconds between reserve recommendations (fresh sessions default execution off).
OVERLORD_RESPONSE_COOLDOWN_SECONDS=15
